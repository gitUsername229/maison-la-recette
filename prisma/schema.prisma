generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Experience {
  id                  Int            @id @default(autoincrement())
  slug                String         @unique
  type                String
  titre               String
  accroche            String
  description         String
  dureeMin            Int
  prixCents           Int
  prixEntrepriseCents Int?
  capaciteMax         Int
  lieu                String?
  image               String
  imageAlt            String
  reservableEnLigne   Boolean        @default(true)
  actif               Boolean        @default(true)
  createdAt           DateTime       @default(now())
  sessions            Session[]
  demandesDevis       DemandeDevis[]
}

model Session {
  id           Int           @id @default(autoincrement())
  experienceId Int
  dateDebut    DateTime
  dateFin      DateTime
  lieu         String
  placesTotal  Int
  placesPrises Int           @default(0)
  prixCents    Int?
  statut       String        @default("ouverte")
  experience   Experience    @relation(fields: [experienceId], references: [id], onDelete: Restrict)
  reservations Reservation[]

  @@index([experienceId, dateDebut])
}

model Reservation {
  id              Int      @id @default(autoincrement())
  sessionId       Int
  nom             String
  email           String
  telephone       String?
  nbPersonnes     Int
  montantCents    Int
  statut          String   @default("en_attente")
  stripeSessionId String?  @unique
  checkoutKey     String?  @unique
  checkoutPayload String?
  createdAt       DateTime @default(now())
  userId          String?
  session         Session  @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  user            User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([sessionId])
  @@index([userId])
}

model DemandeDevis {
  id             Int         @id @default(autoincrement())
  entreprise     String
  contactNom     String
  email          String
  telephone      String?
  typeDemande    String
  experienceId   Int?
  nbParticipants Int?
  dateSouhaitee  DateTime?
  lieuSouhaite   String?
  message        String
  statut         String      @default("nouvelle")
  createdAt      DateTime    @default(now())
  userId         String?
  experience     Experience? @relation(fields: [experienceId], references: [id], onDelete: SetNull)
  user           User?       @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([experienceId])
  @@index([userId])
}

model Episode {
  id              Int      @id @default(autoincrement())
  guid            String?  @unique
  saison          Int      @default(1)
  numero          Int
  titre           String
  description     String
  resume          String   @default("")
  type            String   @default("complet")
  invite          String?
  datePublication DateTime
  dureeMin        Int
  image           String
  embedUrl        String
  spotifyUrl      String?
  deezerUrl       String?
  appleUrl        String?
  youtubeUrl      String?

  @@index([type, saison])
}

model Article {
  id              Int      @id @default(autoincrement())
  slug            String   @unique
  titre           String
  extrait         String
  contenu         String
  image           String
  imageAlt        String
  datePublication DateTime @default(now())
  publie          Boolean  @default(false)
}

model Avis {
  id       Int     @id @default(autoincrement())
  nom      String
  citation String
  contexte String
  note     Int?
  visible  Boolean @default(true)
}

model Partenaire {
  id          Int     @id @default(autoincrement())
  nom         String
  metier      String
  photo       String
  photoAlt    String
  description String
  visible     Boolean @default(false)
}

model Image {
  id    Int    @id @default(autoincrement())
  url   String
  alt   String
  page  String
  ordre Int    @default(0)

  @@index([page, ordre])
}

model Newsletter {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  createdAt DateTime @default(now())
}

// Comptes : tables imposées par Better Auth (src/backend/auth/auth.ts).
// Les modèles Auth* ne s'appellent pas Session/Account pour ne pas entrer en
// conflit avec Session (dates des expériences).

model User {
  id            String         @id
  nom           String
  email         String         @unique
  emailVerified Boolean        @default(false)
  image         String?
  telephone     String?
  role          String         @default("client")
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  sessions      AuthSession[]
  comptes       AuthAccount[]
  reservations  Reservation[]
  demandesDevis DemandeDevis[]
}

model AuthSession {
  id        String   @id
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AuthAccount {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AuthVerification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}
