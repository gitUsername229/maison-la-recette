generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// La base ne garde que ce que les visiteurs envoient : demandes de devis et inscriptions à la newsletter
// (chacune aussi envoyée par e-mail à Julie, MAIL_ADMIN_TO). Le reste du site est du contenu fixe (src/contenu/),
// les événements viennent de Luma et les épisodes d'Ausha.

/// Demande de devis du formulaire /contact
model DemandeDevis {
  id             Int       @id @default(autoincrement())
  entreprise     String
  contactNom     String
  email          String
  telephone      String?
  typeDemande    String
  /// Slug de l'expérience visée (src/contenu/experiences.ts), pour une demande « expérience »
  experience     String?
  nbParticipants Int?
  dateSouhaitee  DateTime?
  lieuSouhaite   String?
  message        String
  /// Case « politique de confidentialité » cochée (null : demande antérieure à la case)
  consentementLe DateTime?
  createdAt      DateTime  @default(now())
}

/// Inscription à la newsletter (formulaire de l'accueil)
model Newsletter {
  id             Int       @id @default(autoincrement())
  email          String    @unique
  /// Case « politique de confidentialité » cochée (null : adresse ajoutée avant la case)
  consentementLe DateTime?
  createdAt      DateTime  @default(now())
}
