# Base de données SQLite locale
DATABASE_URL="file:./dev.db"

# URL publique de base du site
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Stripe (bac à sable / sandbox)
STRIPE_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Comptes (Better Auth) : clé de signature des sessions, générer avec `openssl rand -base64 32`
BETTER_AUTH_SECRET=remplacer-par-une-longue-chaine-aleatoire

# Compte admin créé par le seed (npx prisma db seed)
ADMIN_EMAIL=admin@exemple.fr
ADMIN_PASSWORD=remplacer-par-un-mot-de-passe-solide

# Header x-admin-key pour les tests curl : accepté en développement uniquement
ADMIN_KEY=remplacer-par-une-cle-locale-aleatoire

# E-mails. En local : Mailpit (docker run --rm -p 8025:8025 -p 1025:1025 axllent/mailpit),
# boîte de réception sur http://localhost:8025. Sans SMTP_HOST, les e-mails sont seulement annoncés dans le terminal.
SMTP_HOST=localhost
SMTP_PORT=1025
# Identifiants d'un vrai fournisseur SMTP (production) ; vides avec Mailpit
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Maison La recette <site@maison-la-recette.local>"
# Boîte de Julie (devis et réservations) : adresse fictive en démo
MAIL_ADMIN_TO=julie@exemple.fr

# Flux RSS Podcast Ausha (import des épisodes)
AUSHA_RSS_URL=https://feed.ausha.co/Zg75JI109Rlm

# Anti-spam des formulaires publics (devis, réservation, newsletter) : nombre d'envois acceptés par adresse IP
# sur une période. Valeurs par défaut ci-dessous (production) ; en développement (npm run dev), elles sont
# 20 fois plus larges pour les essais et démonstrations depuis une même adresse. Décommenter pour les changer
# (par exemple pour une démonstration avec npm run build && npm start).
# LIMITE_PERIODE_MINUTES=10
# LIMITE_DEVIS=5
# LIMITE_CHECKOUT=10
# LIMITE_NEWSLETTER=5

# Nombre de proxys de confiance devant le site (ex : 1 derrière nginx ou un hébergeur qui en ajoute un).
# 0 par défaut : l'en-tête x-forwarded-for envoyé par le visiteur est ignoré, l'IP de connexion est utilisée.
# PROXY_DE_CONFIANCE=0
