# Compte admin créé par le seed (npx prisma db seed)
ADMIN_EMAIL=admin@exemple.fr
ADMIN_PASSWORD=remplacer-par-un-mot-de-passe-solide

# Header x-admin-key pour les tests curl : accepté en développement uniquement
ADMIN_KEY=remplacer-par-une-cle-locale-aleatoire
